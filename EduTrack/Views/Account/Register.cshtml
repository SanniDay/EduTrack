@model EduTrack.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <style>
        .register-shell {
            min-height: calc(100vh - 180px);
            display: flex;
            align-items: center;
            padding: 2.5rem 0;
        }

        .register-panel {
            overflow: hidden;
            border: 1px solid rgba(13, 110, 253, .12);
            box-shadow: 0 1.25rem 3rem rgba(15, 23, 42, .12);
        }

        .register-visual {
            background:
                linear-gradient(135deg, rgba(25, 135, 84, .94), rgba(13, 110, 253, .86)),
                radial-gradient(circle at top left, rgba(255, 255, 255, .32), transparent 34%);
            color: #fff;
        }

        .register-icon-wrap {
            width: 4rem;
            height: 4rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, .18);
            border: 1px solid rgba(255, 255, 255, .28);
            border-radius: 1rem;
        }

        .register-feature {
            background: rgba(255, 255, 255, .12);
            border: 1px solid rgba(255, 255, 255, .18);
            border-radius: .75rem;
        }

        .register-form-wrap {
            background: #fff;
        }

        .register-form-wrap .form-control,
        .register-form-wrap .btn {
            min-height: 3.35rem;
        }

        .register-form-wrap .input-group .form-floating > .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .register-form-wrap .password-toggle {
            width: 3.75rem;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        @@media (max-width: 991.98px) {
            .register-shell {
                align-items: flex-start;
                padding-top: 1.5rem;
            }
        }
    </style>
}

<div class="container register-shell">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-xl-11">

            <div class="card register-panel border-0 rounded-4">
                <div class="row g-0">
                    <div class="col-lg-5 register-visual p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <div class="register-icon-wrap mb-4">
                                <i class="bi bi-person-plus fs-1"></i>
                            </div>
                            <p class="text-uppercase fw-semibold small mb-2 opacity-75">EduTrack Registration</p>
                            <h1 class="h2 fw-bold mb-3">Create your account</h1>
                            <p class="mb-0 opacity-75">
                                Join the EduTrack portal to access organized academic workflows, student records, and daily school tools.
                            </p>
                        </div>

                        <div class="row g-3 mt-4">
                            <div class="col-sm-6 col-lg-12">
                                <div class="register-feature p-3 d-flex align-items-center gap-3">
                                    <i class="bi bi-person-badge fs-4"></i>
                                    <div>
                                        <div class="fw-semibold">Personal profile</div>
                                        <div class="small opacity-75">Set up your identity for school access</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-12">
                                <div class="register-feature p-3 d-flex align-items-center gap-3">
                                    <i class="bi bi-lock fs-4"></i>
                                    <div>
                                        <div class="fw-semibold">Protected account</div>
                                        <div class="small opacity-75">Password confirmation keeps setup accurate</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 register-form-wrap p-4 p-md-5">
                        <div class="mx-auto" style="max-width: 36rem;">
                            <div class="mb-4">
                                <span class="badge rounded-pill text-bg-success-subtle text-success-emphasis mb-3">
                                    <i class="bi bi-person-plus me-1"></i> New Account
                                </span>
                                <h2 class="h3 fw-bold mb-2">Register with EduTrack</h2>
                                <p class="text-secondary mb-0">Fill in your details to create a new account.</p>
                            </div>

                            <form asp-action="Register" method="post" novalidate>

                                @if (!ViewData.ModelState.IsValid)
                                {
                                    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage);
                                    <script>
                                        document.addEventListener('DOMContentLoaded', function() {
                                            if (typeof Notyf !== 'undefined') {
                                                var notyf = new Notyf({ duration: 5000, position: { x: 'right', y: 'top' }, dismissible: true });
                                                @foreach (var error in errors)
                                                {
                                                    <text>notyf.error('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(error))');</text>
                                                }
                                            }
                                        });
                                    </script>
                                }

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input asp-for="FullName" class="form-control" placeholder="" />
                                            <label asp-for="FullName"></label>
                                            <span asp-validation-for="FullName"
                                                  class="invalid-feedback d-block"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input asp-for="PhoneNumber" class="form-control" placeholder="" />
                                            <label asp-for="PhoneNumber"></label>
                                            <span asp-validation-for="PhoneNumber"
                                                  class="invalid-feedback d-block"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Email" class="form-control" placeholder="" />
                                            <label asp-for="Email"></label>
                                            <span asp-validation-for="Email"
                                                  class="invalid-feedback d-block"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <div class="form-floating flex-grow-1">
                                                <input asp-for="Password"
                                                       class="form-control"
                                                       placeholder=""
                                                       type="password"
                                                       id="Password" />
                                                <label asp-for="Password"></label>
                                            </div>

                                            <button type="button"
                                                    class="btn btn-outline-secondary password-toggle"
                                                    data-target="#Password"
                                                    title="Show/Hide Password"
                                                    aria-label="Show or hide password">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>

                                        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <div class="form-floating flex-grow-1">
                                                <input asp-for="ConfirmPassword"
                                                       class="form-control"
                                                       placeholder=""
                                                       type="password"
                                                       id="ConfirmPassword" />
                                                <label asp-for="ConfirmPassword"></label>
                                            </div>

                                            <button type="button"
                                                    class="btn btn-outline-secondary password-toggle"
                                                    data-target="#ConfirmPassword"
                                                    title="Show/Hide Password"
                                                    aria-label="Show or hide confirm password">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>

                                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
                                    </div>
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                                        <i class="bi bi-person-plus me-2"></i>Register
                                    </button>
                                </div>

                                <div class="text-center mt-4">
                                    <span class="text-secondary">Already have an account?</span>
                                    <a asp-action="Login" class="text-decoration-none fw-semibold">
                                        Login
                                    </a>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            $("input").on("blur keyup", function () {
                if ($(this).hasClass("input-validation-error")) {
                    $(this).addClass("is-invalid").removeClass("is-valid");
                } else if ($(this).val().length > 0) {
                    $(this).removeClass("is-invalid").addClass("is-valid");
                } else {
                    $(this).removeClass("is-valid is-invalid");
                }
            });

            // Password show/hide toggle
            $(document).on('click', '.password-toggle', function () {
                var targetSelector = $(this).data('target');
                var $target = $(targetSelector);
                if (!$target || $target.length === 0) return;
                var $icon = $(this).find('i');
                if ($target.attr('type') === 'password') {
                    $target.attr('type', 'text');
                    $icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    $target.attr('type', 'password');
                    $icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

        });
    </script>
}
