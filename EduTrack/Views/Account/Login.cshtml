@model EduTrack.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <style>
        .login-shell {
            min-height: calc(100vh - 180px);
            display: flex;
            align-items: center;
            padding: 2.5rem 0;
        }

        .login-panel {
            overflow: hidden;
            border: 1px solid rgba(13, 110, 253, .12);
            box-shadow: 0 1.25rem 3rem rgba(15, 23, 42, .12);
        }

        .login-visual {
            background:
                linear-gradient(135deg, rgba(13, 110, 253, .94), rgba(32, 201, 151, .86)),
                radial-gradient(circle at top left, rgba(255, 255, 255, .32), transparent 34%);
            color: #fff;
        }

        .login-icon-wrap {
            width: 4rem;
            height: 4rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, .18);
            border: 1px solid rgba(255, 255, 255, .28);
            border-radius: 1rem;
        }

        .login-feature {
            background: rgba(255, 255, 255, .12);
            border: 1px solid rgba(255, 255, 255, .18);
            border-radius: .75rem;
        }

        .login-form-wrap {
            background: #fff;
        }

        .login-form-wrap .form-control,
        .login-form-wrap .btn {
            min-height: 3.35rem;
        }

        .login-form-wrap .input-group .form-floating > .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .login-form-wrap .password-toggle {
            width: 3.75rem;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        @@media (max-width: 991.98px) {
            .login-shell {
                align-items: flex-start;
                padding-top: 1.5rem;
            }
        }
    </style>
}

<div class="container login-shell">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-xl-10">

            <div class="card login-panel border-0 rounded-4">
                <div class="row g-0">
                    <div class="col-lg-5 login-visual p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <div class="login-icon-wrap mb-4">
                                <i class="bi bi-mortarboard fs-1"></i>
                            </div>
                            <p class="text-uppercase fw-semibold small mb-2 opacity-75">EduTrack Portal</p>
                            <h1 class="h2 fw-bold mb-3">Welcome back</h1>
                            <p class="mb-0 opacity-75">
                                Sign in to continue managing classes, attendance, fees, and academic records from one place.
                            </p>
                        </div>

                        <div class="row g-3 mt-4">
                            <div class="col-sm-6 col-lg-12">
                                <div class="login-feature p-3 d-flex align-items-center gap-3">
                                    <i class="bi bi-shield-check fs-4"></i>
                                    <div>
                                        <div class="fw-semibold">Secure access</div>
                                        <div class="small opacity-75">Role-based account area</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-12">
                                <div class="login-feature p-3 d-flex align-items-center gap-3">
                                    <i class="bi bi-graph-up-arrow fs-4"></i>
                                    <div>
                                        <div class="fw-semibold">Organized workflow</div>
                                        <div class="small opacity-75">Built for daily school operations</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 login-form-wrap p-4 p-md-5">
                        <div class="mx-auto" style="max-width: 31rem;">
                            <div class="mb-4">
                                <span class="badge rounded-pill text-bg-primary-subtle text-primary-emphasis mb-3">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Account Login
                                </span>
                                <h2 class="h3 fw-bold mb-2">Login to your account</h2>
                                <p class="text-secondary mb-0">Enter your credentials to access EduTrack.</p>
                            </div>

                            <form asp-action="Login" method="post" novalidate>

                                @if (!ViewData.ModelState.IsValid)
                                {
                                    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage);
                                    <script>
                                        document.addEventListener('DOMContentLoaded', function() {
                                            if (typeof Notyf !== 'undefined') {
                                                var notyf = new Notyf({ duration: 5000, position: { x: 'right', y: 'top' }, dismissible: true });
                                                @foreach (var error in errors)
                                                {
                                                    <text>notyf.error('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(error))');</text>
                                                }
                                            }
                                        });
                                    </script>
                                }

                                <div class="form-floating mb-3">
                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="" />
                                    <label asp-for="Email"></label>
                                    <span asp-validation-for="Email"
                                          class="invalid-feedback d-block"></span>
                                </div>

                                <div class="mb-3">
                                    <div class="input-group">
                                        <div class="form-floating flex-grow-1">
                                            <input asp-for="Password"
                                                   class="form-control"
                                                   placeholder=""
                                                   type="password"
                                                   id="Password" />
                                            <label asp-for="Password"></label>
                                        </div>

                                        <button type="button"
                                                class="btn btn-outline-secondary password-toggle"
                                                data-target="#Password"
                                                title="Show/Hide Password"
                                                aria-label="Show or hide password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>

                                    <span asp-validation-for="Password"
                                          class="invalid-feedback d-block"></span>
                                </div>

                                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
                                    <div class="form-check mb-0">
                                        <input asp-for="RememberMe"
                                               class="form-check-input" />
                                        <label asp-for="RememberMe"
                                               class="form-check-label">
                                            Remember Me
                                        </label>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button type="submit"
                                            class="btn btn-primary btn-lg fw-semibold">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                                    </button>
                                </div>

                                <div class="text-center mt-4">
                                    <span class="text-secondary">Don't have an account?</span>
                                    <a asp-action="Register"
                                       class="text-decoration-none fw-semibold">
                                        Register
                                    </a>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $("input").not("[type='password']").on("blur keyup", function () {
                if ($(this).hasClass("input-validation-error")) {
                    $(this).addClass("is-invalid").removeClass("is-valid");
                } else {
                    if ($(this).val().length > 0) {
                        $(this).removeClass("is-invalid").addClass("is-valid");
                    }
                }
            });

            // Password show/hide toggle
            $(document).on('click', '.password-toggle', function () {
                var targetSelector = $(this).data('target');
                var $target = $(targetSelector);
                if (!$target || $target.length === 0) return;
                var $icon = $(this).find('i');
                if ($target.attr('type') === 'password') {
                    $target.attr('type', 'text');
                    $icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    $target.attr('type', 'password');
                    $icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

        });
    </script>
}
