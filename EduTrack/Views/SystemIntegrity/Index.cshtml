@model EduTrack.ViewModels.SystemIntegrityViewModel
@{
    ViewData["Title"] = "System Integrity";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-body">
                    <h6>Summary</h6>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between"><span>Total Issues</span><strong>@Model.TotalIssues</strong></div>
                        <div class="d-flex justify-content-between"><span>Critical</span><span class="badge bg-danger">@Model.CriticalCount</span></div>
                        <div class="d-flex justify-content-between"><span>Warning</span><span class="badge bg-warning">@Model.WarningCount</span></div>
                        <div class="d-flex justify-content-between"><span>Info</span><span class="badge bg-secondary">@Model.InfoCount</span></div>
                    </div>
                    <hr />
                    <a asp-action="ExportCsv" class="btn btn-outline-primary w-100">Export CSV</a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h6>Filters</h6>
                    <form method="get">
                        <div class="mb-2">
                            <label class="form-label small">Module</label>
                            <input name="module" value="@Model.ModuleFilter" class="form-control" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Severity</label>
                            <select name="severity" class="form-select">
                                <option value="">Any</option>
                                <option value="Critical" selected="@(Model.SeverityFilter=="Critical")">Critical</option>
                                <option value="Warning" selected="@(Model.SeverityFilter=="Warning")">Warning</option>
                                <option value="Info" selected="@(Model.SeverityFilter=="Info")">Info</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Issue Type</label>
                            <input name="issueType" value="@Model.IssueTypeFilter" class="form-control" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Search</label>
                            <input name="search" value="@Model.Search" class="form-control" />
                        </div>
                        <div>
                            <button class="btn btn-primary w-100">Filter</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card mb-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">System Integrity - Broken Relations</h5>
                    <div>
                        <button id="bulkResolveBtn" class="btn btn-success btn-sm me-1">Bulk Restore</button>
                        <button id="bulkDeleteBtn" class="btn btn-danger btn-sm">Bulk Delete</button>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <form id="bulkForm" method="post" asp-action="BulkFix" asp-controller="SystemIntegrity">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="actionType" id="bulkActionType" />

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;"><input type="checkbox" id="selectAllCheckbox" /></th>
                                        <th>IssueType</th>
                                        <th>Module</th>
                                        <th>RecordId</th>
                                        <th>MissingModule</th>
                                        <th>MissingId</th>
                                        <th>Description</th>
                                        <th>Severity</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var issue in Model.Issues)
                                    {
                                        <tr>
                                            <td><input type="checkbox" name="recordIds" value="@issue.RecordId" class="rowCheckbox" /></td>
                                            <td>@issue.IssueType</td>
                                            <td>@issue.Module</td>
                                            <td>@issue.RecordId</td>
                                            <td>@issue.MissingModule</td>
                                            <td>@issue.MissingId</td>
                                            <td>@issue.Description</td>
                                            <td>
                                                @if(string.Equals(issue.Severity, "Critical", StringComparison.OrdinalIgnoreCase)) { <span class="badge bg-danger">Critical</span> }
                                                else if(string.Equals(issue.Severity, "Warning", StringComparison.OrdinalIgnoreCase)) { <span class="badge bg-warning">Warning</span> }
                                                else { <span class="badge bg-secondary">Info</span> }
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <form method="post" asp-action="RestoreReferenced" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="module" value="@issue.MissingModule" />
                                                        <input type="hidden" name="missingId" value="@issue.MissingId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Restore Referenced</button>
                                                    </form>

                                                    <form method="post" asp-action="DeleteOrphan" class="d-inline ms-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="module" value="@issue.Module" />
                                                        <input type="hidden" name="recordId" value="@issue.RecordId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete Orphan</button>
                                                    </form>

                                                    <form method="post" asp-action="Ignore" class="d-inline ms-1">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="module" value="@issue.Module" />
                                                        <input type="hidden" name="recordId" value="@issue.RecordId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Ignore</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function(){
            $('#selectAllCheckbox').on('change', function(){ $('.rowCheckbox').prop('checked', $(this).prop('checked')); });
            $('#bulkResolveBtn').on('click', function(){
                var ids = $('.rowCheckbox:checked').map(function(){ return $(this).val(); }).get();
                var modules = $('.rowCheckbox:checked').map(function(){ return $(this).closest('tr').find('td:nth-child(3)').text().trim(); }).get();
                if(ids.length==0){ alert('No items selected'); return; }
                if(!confirm('Restore referenced records for selected issues?')) return;
                submitBulk('restore', ids, modules);
            });

            $('#bulkDeleteBtn').on('click', function(){
                var ids = $('.rowCheckbox:checked').map(function(){ return $(this).val(); }).get();
                var modules = $('.rowCheckbox:checked').map(function(){ return $(this).closest('tr').find('td:nth-child(3)').text().trim(); }).get();
                if(ids.length==0){ alert('No items selected'); return; }
                if(!confirm('Permanently delete referenced orphan records for selected issues?')) return;
                submitBulk('delete', ids, modules);
            });

            function submitBulk(actionType, ids, modules){
                var data = { actionType: actionType, recordIds: ids, modules: modules };
                $.ajax({
                    url: '@Url.Action("BulkFix","SystemIntegrity")',
                    method: 'POST',
                    data: data,
                    success: function(resp){
                        alert('Bulk operation completed. Success: ' + resp.success + ', Failed: ' + resp.failed);
                        location.reload();
                    },
                    error: function(){ alert('Bulk operation failed'); }
                });
            }
        });
    </script>
}
