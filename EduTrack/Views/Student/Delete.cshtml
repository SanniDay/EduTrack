@model EduTrack.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Delete Student</h5>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">⚠️ Confirm Deletion</h4>
                        <p>Are you sure you want to delete this student? This action cannot be undone.</p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Name:</strong></div>
                        <div class="col-8">@Model.FullName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4"><strong>Phone:</strong></div>
                        <div class="col-8">@Model.Phone_No</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4"><strong>DOB:</strong></div>
                        <div class="col-8">@Model.DOB.ToString("dd MMM yyyy")</div>
                    </div>
                </div>

                <div class="card-footer">
                    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
                        <input type="hidden" name="Student_Id" value="@Model.Student_Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
