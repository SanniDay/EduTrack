@using System.Security.Claims
@using System.Linq
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduTrack</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduTrack.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap-icon/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/notyf/notyf.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Logo -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    EduTrack
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- LEFT MENU: organized by role for easier maintenance -->
                    <ul class="navbar-nav me-auto">

                        <!-- Common links -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock me-1"></i> Privacy
                            </a>
                        </li>

                        @* Student quick links (visible only to Students) *@
                        @if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/StudentFees/Index">
                                    <i class="bi bi-receipt-cutoff me-1"></i> My Fees
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Attendance/Index">
                                    <i class="bi bi-calendar-check me-1"></i> Attendance
                                </a>
                            </li>
                        }

                        @* Admin menu: management + academic *@
                        @if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear me-1"></i> Management
                                </a>
                                <ul class="dropdown-menu shadow">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Role" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2"></i> Roles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Fees/Index">
                                            <i class="bi bi-cash-stack me-2"></i> Fees
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/StudentFees/Index">
                                            <i class="bi bi-receipt-cutoff me-2"></i> Student Fees
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-mortarboard me-1"></i> Academic
                                </a>
                                <ul class="dropdown-menu shadow">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Classes/Index">
                                            <i class="bi bi-door-open me-2"></i> Classes
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Subjects/Index">
                                            <i class="bi bi-book me-2"></i> Subjects
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/ClassSubjects/Index">
                                            <i class="bi bi-book-half me-2"></i> Class Subjects
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/StudentClasses/Index">
                                            <i class="bi bi-people-fill me-2"></i> Student Classes
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/TeacherClasses/Index">
                                            <i class="bi bi-mortarboard-fill me-2"></i> Teacher Classes
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Attendance/Index">
                                            <i class="bi bi-check-circle me-2"></i> Attendance
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @* Admin or Teacher: important management links (visible to both) *@
                        @if (User?.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Teacher")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Users
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Teacher" asp-action="Index">
                                    <i class="bi bi-keyboard me-1"></i> Teachers
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Index">
                                    <i class="bi bi-person-lines-fill me-1"></i> Students
                                </a>
                            </li>

                            @* Teachers also need quick access to fees/student-fees for their classes; keep link visible to Teacher *@
                            @if (User.IsInRole("Teacher"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Fees/Index">
                                        <i class="bi bi-cash-stack me-1"></i> Fees
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/StudentFees/Index">
                                        <i class="bi bi-receipt-cutoff me-1"></i> Student Fees
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Attendance/Index">
                                        <i class="bi bi-calendar-check me-1"></i> Attendance
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <!-- RIGHT PROFILE -->
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle d-flex align-items-center"
                               href="#"
                               id="profileDropdown"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-person-circle fs-4"></i>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow"
                                aria-labelledby="profileDropdown">

                                <!-- Theme Toggle -->
                                <li class="px-4 py-2">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <i class="bi bi-sun-fill text-warning"></i>

                                        <div class="form-check form-switch mx-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="themeToggle">
                                        </div>

                                        <i class="bi bi-moon-fill text-secondary"></i>
                                    </div>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                @if (User?.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    var displayName = User.Identity.Name ?? "";
                                    var roles = User.Claims
                                    .Where(c => c.Type == ClaimTypes.Role)
                                    .Select(c => c.Value)
                                    .ToList();
                                    var roleText = roles.Any() ? string.Join(", ", roles) : "No role assigned";

                                    <li class="px-3">
                                        <div class="small text-muted">Signed in as</div>
                                        <div class="fw-bold">@displayName</div>
                                        <div class="small text-secondary">Role: @roleText</div>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            <i class="bi bi-person me-2"></i> Profile
                                        </a>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Role" asp-action="Index">
                                                <i class="bi bi-shield-lock me-2"></i> Manage Roles
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                            <i class="bi bi-person-plus me-2"></i> Register
                                        </a>
                                    </li>
                                }

                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_NotificationPartial" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 - EduTrack -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/notyf/notyf.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Initialize Select2 on all select elements that don't explicitly opt-out
            $('select').not('.no-select2').select2({
                width: '100%'
            });

            // Initialize Flatpickr on date inputs
            $('input[type="date"]').flatpickr({
                dateFormat: "Y-m-d",
                allowInput: true
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>