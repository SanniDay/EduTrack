@* Unified toast notifications using local toast.js (Bootstrap-based) *@
@{ 
    var success = TempData["Success"] ?? TempData["Message"];
    var error = TempData["Error"];
}

@if (success != null)
{
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function(){
            try {
                Toast.show('success', '@Html.Raw(success.ToString().Replace("'","\'"))', 'Success');
            } catch(e) { console.error(e); }
        });
    </script>
}

@if (error != null)
{
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function(){
            try {
                Toast.show('error', '@Html.Raw(error.ToString().Replace("'","\'"))', 'Error');
            } catch(e) { console.error(e); }
        });
    </script>
}
