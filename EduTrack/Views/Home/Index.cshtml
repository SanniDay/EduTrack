@model EduTrack.ViewModels.DashboardViewModel
@using EduTrack.Constants

@{
    ViewData["Title"] = "Dashboard";

    var roleTone = Model.UserRole == AppRoles.Admin ? "primary"
        : Model.UserRole == AppRoles.Teacher ? "success"
        : Model.UserRole == AppRoles.Student ? "warning"
        : "secondary";

    var displayName = Model.UserRole == AppRoles.Teacher && !string.IsNullOrWhiteSpace(Model.TeacherName)
        ? Model.TeacherName
        : Model.UserRole == AppRoles.Student && !string.IsNullOrWhiteSpace(Model.StudentName)
            ? Model.StudentName
            : Model.DisplayName;
}

<div class="dashboard-page py-3 py-lg-4">
    <section class="dashboard-hero mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="dashboard-role-icon text-@roleTone bg-@roleTone bg-opacity-10">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <div>
                        <div class="text-uppercase text-secondary small fw-semibold">EduTrack Dashboard</div>
                        <h1 class="h2 fw-bold mb-0">Welcome back, @displayName</h1>
                    </div>
                </div>
                <p class="text-secondary mb-0">
                    Signed in as <span class="badge rounded-pill bg-@roleTone">@Model.UserRole</span>
                    <span class="mx-2 text-muted">|</span>
                    @Model.CurrentDateTime
                </p>
            </div>
            <div class="col-lg-4">
                <div class="dashboard-now p-3">
                    <div class="small text-secondary fw-semibold mb-2">Today at a glance</div>
                    @if (Model.CurrentClass != null)
                    {
                        <div class="fw-bold">Current class: @Model.CurrentClass.SubjectName</div>
                        <div class="text-secondary small">
                            @Model.CurrentClass.Start_Time.ToString("hh\\:mm") - @Model.CurrentClass.End_Time.ToString("hh\\:mm")
                            in @Model.CurrentClass.Room_No
                        </div>
                    }
                    else if (Model.NextClass != null)
                    {
                        <div class="fw-bold">Next class: @Model.NextClass.SubjectName</div>
                        <div class="text-secondary small">
                            Starts at @Model.NextClass.Start_Time.ToString("hh\\:mm") in @Model.NextClass.Room_No
                        </div>
                    }
                    else
                    {
                        <div class="fw-bold">No more scheduled classes today</div>
                        <div class="text-secondary small">Use the quick actions below to continue your work.</div>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (Model.UserRole == AppRoles.Admin)
    {
        <section class="mb-4">
            <div class="section-heading">
                <div>
                    <h2 class="h5 fw-bold mb-1">Institution Overview</h2>
                    <p class="text-secondary mb-0">Live operational summary across users, academics, fees, and attendance.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people-fill"></i></div>
                        <div class="text-secondary small fw-semibold">Users</div>
                        <div class="metric-value">@Model.TotalUsers</div>
                        <div class="text-secondary small">@Model.ActiveUsers active accounts</div>
                        <a asp-controller="User" asp-action="Index" class="stretched-link" aria-label="Manage users"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-badge"></i></div>
                        <div class="text-secondary small fw-semibold">Teachers</div>
                        <div class="metric-value">@Model.TotalTeachers</div>
                        <div class="text-secondary small">@Model.ActiveTeachers active teacher profiles</div>
                        <a asp-controller="Teacher" asp-action="Index" class="stretched-link" aria-label="Manage teachers"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-mortarboard-fill"></i></div>
                        <div class="text-secondary small fw-semibold">Students</div>
                        <div class="metric-value">@Model.TotalStudents</div>
                        <div class="text-secondary small">@Model.ActiveStudents active student profiles</div>
                        <a asp-controller="Student" asp-action="Index" class="stretched-link" aria-label="Manage students"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-shield-lock-fill"></i></div>
                        <div class="text-secondary small fw-semibold">Roles</div>
                        <div class="metric-value">@Model.TotalRoles</div>
                        <div class="text-secondary small">Configured access groups</div>
                        <a asp-controller="Role" asp-action="Index" class="stretched-link" aria-label="Manage roles"></a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-title">
                            <i class="bi bi-building text-primary"></i>
                            Academic Setup
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="mini-stat">
                                    <div class="mini-value">@Model.TotalClasses</div>
                                    <div class="text-secondary small">Classes</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat">
                                    <div class="mini-value">@Model.TotalSubjects</div>
                                    <div class="text-secondary small">Subjects</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat">
                                    <div class="mini-value">@Model.TotalClassSubjects</div>
                                    <div class="text-secondary small">Class subjects</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat">
                                    <div class="mini-value">@Model.TimetableEntries</div>
                                    <div class="text-secondary small">Timetable entries</div>
                                </div>
                            </div>
                        </div>
                        <div class="quick-actions mt-3">
                            <a asp-page="/Classes/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-door-open me-1"></i>Classes</a>
                            <a asp-page="/Subjects/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-book me-1"></i>Subjects</a>
                            <a asp-page="/TimeTable/Index" class="btn btn-outline-primary btn-sm"><i class="bi bi-calendar3 me-1"></i>Timetable</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-title">
                            <i class="bi bi-cash-stack text-success"></i>
                            Fee Snapshot
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-secondary">Fee structures</span>
                            <strong>@Model.TotalFeeStructures</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-secondary">Collected</span>
                            <strong>@Model.CollectedFeesAmount.ToString("C0")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-secondary">Pending or overdue</span>
                            <strong>@Model.PendingFeesAmount.ToString("C0")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2">
                            <span class="text-secondary">Overdue records</span>
                            <strong class="text-danger">@Model.OverdueFeesCount</strong>
                        </div>
                        <div class="quick-actions mt-3">
                            <a asp-page="/Fees/Index" class="btn btn-outline-success btn-sm"><i class="bi bi-cash me-1"></i>Fees</a>
                            <a asp-page="/StudentFees/Index" class="btn btn-outline-success btn-sm"><i class="bi bi-receipt me-1"></i>Student Fees</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-title">
                            <i class="bi bi-calendar-check text-info"></i>
                            Attendance Today
                        </div>
                        <div class="attendance-ring mx-auto my-3">
                            <div>
                                <div class="metric-value">@Model.TodayAttendanceMarked</div>
                                <div class="text-secondary small">marked</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <div class="mini-stat flex-fill">
                                <div class="mini-value text-success">@Model.PresentToday</div>
                                <div class="text-secondary small">Present</div>
                            </div>
                            <div class="mini-stat flex-fill">
                                <div class="mini-value text-danger">@Model.AbsentToday</div>
                                <div class="text-secondary small">Absent</div>
                            </div>
                        </div>
                        <div class="quick-actions mt-3">
                            <a asp-page="/Attendance/Index" class="btn btn-outline-info btn-sm"><i class="bi bi-calendar-check me-1"></i>Attendance</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (Model.UserRole == AppRoles.Teacher)
    {
        <section class="mb-4">
            <div class="section-heading">
                <div>
                    <h2 class="h5 fw-bold mb-1">Classroom Hub</h2>
                    <p class="text-secondary mb-0">Your assigned classes, students, timetable, and daily attendance work.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-door-open"></i></div>
                        <div class="text-secondary small fw-semibold">Assigned Classes</div>
                        <div class="metric-value">@Model.ActiveClasses</div>
                        <div class="text-secondary small">Active class assignments</div>
                        <a asp-page="/TeacherClasses/Index" class="stretched-link" aria-label="View teacher classes"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people"></i></div>
                        <div class="text-secondary small fw-semibold">Students Reached</div>
                        <div class="metric-value">@Model.EnrolledStudents</div>
                        <div class="text-secondary small">Across assigned classes</div>
                        <a asp-controller="Student" asp-action="Index" class="stretched-link" aria-label="View students"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-book-half"></i></div>
                        <div class="text-secondary small fw-semibold">Subjects</div>
                        <div class="metric-value">@Model.TotalSubjects</div>
                        <div class="text-secondary small">Distinct subjects assigned</div>
                        <a asp-page="/ClassSubjects/Index" class="stretched-link" aria-label="View class subjects"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-info bg-opacity-10 text-info"><i class="bi bi-calendar-check"></i></div>
                        <div class="text-secondary small fw-semibold">Marked Today</div>
                        <div class="metric-value">@Model.AttendanceMarkedByMeToday</div>
                        <div class="text-secondary small">Attendance records</div>
                        <a asp-page="/Attendance/Index" class="stretched-link" aria-label="Manage attendance"></a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <div class="dashboard-panel">
                <div class="panel-title">
                    <i class="bi bi-lightning-charge text-success"></i>
                    Teacher Actions
                </div>
                <div class="quick-actions">
                    <a asp-page="/Attendance/Index" class="btn btn-outline-success"><i class="bi bi-calendar-check me-1"></i>Attendance</a>
                    <a asp-page="/TimeTable/Index" class="btn btn-outline-primary"><i class="bi bi-calendar3 me-1"></i>Timetable</a>
                    <a asp-page="/StudentFees/Index" class="btn btn-outline-secondary"><i class="bi bi-receipt me-1"></i>Student Fees</a>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-person-lines-fill me-1"></i>Students</a>
                </div>
            </div>
        </section>
    }
    else if (Model.UserRole == AppRoles.Student)
    {
        <section class="mb-4">
            <div class="section-heading">
                <div>
                    <h2 class="h5 fw-bold mb-1">Student Portal</h2>
                    <p class="text-secondary mb-0">
                        @if (!string.IsNullOrWhiteSpace(Model.PrimaryClassName))
                        {
                            <span>Class: <strong>@Model.PrimaryClassName</strong></span>
                        }
                        else
                        {
                            <span>Your classes, attendance, fees, and schedule in one place.</span>
                        }
                    </p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-mortarboard-fill"></i></div>
                        <div class="text-secondary small fw-semibold">Classes</div>
                        <div class="metric-value">@Model.ActiveClasses</div>
                        <div class="text-secondary small">@Model.TotalSubjects subjects assigned</div>
                        <a asp-page="/TimeTable/Index" class="stretched-link" aria-label="View timetable"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-clipboard2-check"></i></div>
                        <div class="text-secondary small fw-semibold">Attendance</div>
                        <div class="metric-value">@Model.AttendancePercentage.ToString("0.#")%</div>
                        <div class="text-secondary small">@Model.PresentRecords of @Model.AttendanceRecords records present</div>
                        <a asp-page="/Attendance/Index" class="stretched-link" aria-label="View attendance"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-receipt-cutoff"></i></div>
                        <div class="text-secondary small fw-semibold">Pending Fees</div>
                        <div class="metric-value">@Model.PendingFeesCount</div>
                        <div class="text-secondary small">@Model.MyPendingFeesAmount.ToString("C0") pending</div>
                        <a asp-page="/StudentFees/Index" class="stretched-link" aria-label="View fees"></a>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-calendar3"></i></div>
                        <div class="text-secondary small fw-semibold">Today</div>
                        <div class="metric-value">@Model.TodayClassCount</div>
                        <div class="text-secondary small">Classes scheduled</div>
                        <a asp-page="/TimeTable/Index" class="stretched-link" aria-label="View timetable"></a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <div class="dashboard-panel">
                <div class="panel-title">
                    <i class="bi bi-compass text-warning"></i>
                    Student Shortcuts
                </div>
                <div class="quick-actions">
                    <a asp-page="/StudentFees/Index" class="btn btn-outline-warning"><i class="bi bi-receipt-cutoff me-1"></i>My Fees</a>
                    <a asp-page="/Attendance/Index" class="btn btn-outline-success"><i class="bi bi-calendar-check me-1"></i>My Attendance</a>
                    <a asp-page="/TimeTable/Index" class="btn btn-outline-primary"><i class="bi bi-calendar3 me-1"></i>My Timetable</a>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-info-circle-fill me-2"></i>
            You currently are not mapped to an active system role. Please contact an administrator.
        </div>
    }

    @if (Model.WeeklyTimetable != null && Model.WeeklyTimetable.Any())
    {
        <section class="mb-4">
            <div class="section-heading">
                <div>
                    <h2 class="h5 fw-bold mb-1">Schedule</h2>
                    <p class="text-secondary mb-0">Today and weekly timetable based on your current role.</p>
                </div>
                <a asp-page="/TimeTable/Index" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-calendar3 me-1"></i>Open Timetable
                </a>
            </div>

            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-title">
                            <i class="bi bi-clock-history text-primary"></i>
                            Today's Classes
                        </div>

                        @if (Model.TodayClasses != null && Model.TodayClasses.Any())
                        {
                            <div class="timeline-list">
                                @foreach (var c in Model.TodayClasses)
                                {
                                    var isCurrent = Model.CurrentClass != null && Model.CurrentClass.TimeTable_Id == c.TimeTable_Id;
                                    var isNext = Model.NextClass != null && Model.NextClass.TimeTable_Id == c.TimeTable_Id;

                                    <div class="timeline-item @(isCurrent ? "is-current" : isNext ? "is-next" : "")">
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                            <div class="d-flex justify-content-between gap-2">
                                                <strong>@c.SubjectName</strong>
                                                <span class="small text-secondary">@c.Start_Time.ToString("hh\\:mm")</span>
                                            </div>
                                            <div class="small text-secondary">
                                                @c.ClassName
                                                @if (!string.IsNullOrWhiteSpace(c.Room_No))
                                                {
                                                    <span>| Room @c.Room_No</span>
                                                }
                                            </div>
                                            @if (isCurrent)
                                            {
                                                <span class="badge bg-primary mt-2">Happening now</span>
                                            }
                                            else if (isNext)
                                            {
                                                <span class="badge bg-info mt-2">Up next</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-calendar2-x"></i>
                                <div class="fw-semibold">No classes today</div>
                                <div class="text-secondary small">Your schedule is clear for today.</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="dashboard-panel h-100">
                        <div class="panel-title">
                            <i class="bi bi-calendar-week text-primary"></i>
                            Weekly Schedule
                        </div>
                        <div class="weekly-strip">
                            @{
                                var palette = new[] { "primary", "success", "warning", "danger", "info", "secondary" };
                            }
                            @foreach (var day in Model.WeeklyTimetable)
                            {
                                <div class="day-column">
                                    <div class="day-title">@day.Key</div>
                                    @if (day.Value != null && day.Value.Any())
                                    {
                                        var entryIndex = 0;
                                        foreach (var entry in day.Value)
                                        {
                                            var tone = palette[entryIndex % palette.Length];
                                            entryIndex++;
                                            <div class="schedule-chip border-@tone">
                                                <div class="d-flex justify-content-between align-items-center gap-2">
                                                    <strong class="text-truncate" title="@entry.SubjectName">@entry.SubjectName</strong>
                                                    <span class="badge bg-@tone">P @entry.Period_No</span>
                                                </div>
                                                <div class="small text-secondary">
                                                    @entry.Start_Time.ToString("hh\\:mm") - @entry.End_Time.ToString("hh\\:mm")
                                                </div>
                                                <div class="small text-secondary text-truncate">
                                                    @entry.ClassName
                                                    @if (!string.IsNullOrWhiteSpace(entry.Room_No))
                                                    {
                                                        <span>| @entry.Room_No</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="empty-day">No classes</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@section Styles {
    <style>
        .dashboard-hero,
        .dashboard-panel,
        .metric-card {
           
            border: 1px solid rgba(15, 23, 42, .08);
            box-shadow: 0 .75rem 2rem rgba(15, 23, 42, .07);
        }

        .dashboard-hero {
            border-radius: .75rem;
            padding: 1.5rem;
        }

        .dashboard-role-icon,
        .metric-icon {
            width: 3rem;
            height: 3rem;
            border-radius: .75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex: 0 0 auto;
        }

        .dashboard-now {
            background: var(--bs-tertiary-bg);
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: .75rem;
        }

        .section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .metric-card {
            position: relative;
            min-height: 11rem;
            border-radius: .75rem;
            padding: 1.25rem;
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 1rem 2.25rem rgba(15, 23, 42, .1);
        }

        .metric-value {
            font-size: clamp(1.85rem, 3vw, 2.6rem);
            line-height: 1;
            font-weight: 800;
            margin: .75rem 0 .35rem;
        }

        .dashboard-panel {
            border-radius: .75rem;
            padding: 1.25rem;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .mini-stat {
            background: var(--bs-tertiary-bg);
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: .6rem;
            padding: .85rem;
        }

        .mini-value {
            font-weight: 800;
            font-size: 1.35rem;
            line-height: 1.1;
        }

        .quick-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .65rem;
        }

        .attendance-ring {
            width: 9.5rem;
            height: 9.5rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(circle at center, var(--bs-body-bg) 56%, transparent 57%),
                conic-gradient(#0dcaf0 0 72%, var(--bs-secondary-bg) 72% 100%);
        }

        .timeline-list {
            display: grid;
            gap: .85rem;
        }

        .timeline-item {
            display: grid;
            grid-template-columns: 1rem 1fr;
            gap: .75rem;
        }

        .timeline-dot {
            width: .75rem;
            height: .75rem;
            border-radius: 50%;
            background: var(--bs-secondary-color);
            margin-top: .45rem;
        }

        .timeline-item.is-current .timeline-dot {
            background: #0d6efd;
        }

        .timeline-item.is-next .timeline-dot {
            background: #0dcaf0;
        }

        .timeline-content,
        .schedule-chip {
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: .6rem;
            padding: .85rem;
            background: var(--bs-tertiary-bg);
        }

        .timeline-item.is-current .timeline-content {
            background: rgba(13, 110, 253, .08);
            border-color: rgba(13, 110, 253, .25);
        }

        .weekly-strip {
            display: grid;
            grid-auto-flow: column;
