@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Privacy Policy</h3>
                    <small class="text-muted">Last updated: @DateTime.UtcNow.ToString("dd MMM yyyy")</small>
                </div>
                <div class="card-body">
                    <p class="lead text-secondary">EduTrack is committed to protecting your privacy. This privacy policy explains how we collect, use, and safeguard your personal information.</p>

                    <h5 class="mt-4">1. Information We Collect</h5>
                    <ul>
                        <li>Account details (name, email, phone, role)</li>
                        <li>Academic records and enrollment data</li>
                        <li>Activity logs for auditing and support</li>
                    </ul>

                    <h5 class="mt-3">2. How We Use Information</h5>
                    <p class="text-muted">We use collected data to provide and improve our services, manage accounts, and communicate important notices such as account activation and schedule changes.</p>

                    <h5 class="mt-3">3. Data Retention</h5>
                    <p class="text-muted">We retain personal data only as long as necessary for the purposes described, and in accordance with legal obligations.</p>

                    <h5 class="mt-3">4. Security</h5>
                    <p class="text-muted">We follow industry-standard practices to protect personal information from unauthorized access or disclosure. Access to sensitive operations is audited.</p>

                    <h5 class="mt-3">5. Contact</h5>
                    <p class="text-muted">If you have questions about this policy or need assistance, contact our support team at <a href="mailto:support@edutrack.local">support@edutrack.local</a>.</p>

                    <div class="mt-4 text-muted small">This privacy policy is provided for informational purposes and does not constitute legal advice.</div>
                </div>
            </div>
        </div>
    </div>
</div>
