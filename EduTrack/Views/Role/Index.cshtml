@model List<EduTrack.Models.Role>

@{
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-shield-lock"></i> Role Management</h4>
            <a asp-controller="Role" asp-action="Create" class="btn btn-light btn-sm fw-bold text-primary">
                <i class="bi bi-plus-circle"></i> Create New Role
            </a>
        </div>

        <div class="card-body table-responsive">
            <table id="roleTable" class="table table-bordered table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Role Name</th>
                        <th>Created Date</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Role_Id</td>
                        <td class="fw-bold">@r.Role_Name</td>
                        <td>@(r.Created_Date == DateTime.MinValue ? "N/A" : r.Created_Date.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td>
                            @if(r.IsActive) {
                                <span class="badge bg-success">Yes</span>
                            } else {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-controller="Role" asp-action="Edit" asp-route-id="@r.Role_Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="Role" asp-action="Delete" asp-route-id="@r.Role_Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#roleTable').DataTable({
                "pageLength": 10,
                "responsive": true,
                "stateSave": true
            });
        });
    </script>
}
