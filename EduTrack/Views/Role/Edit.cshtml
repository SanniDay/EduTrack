@model EduTrack.Models.Role
@{
    ViewData["Title"] = "Edit Role Configuration";
}

<div class="container mt-5">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-0 text-primary fw-bold">Edit System Role</h2>
            <p class="text-muted">Modify access role settings.</p>
        </div>
        <div class="col-auto">
             <a asp-action="Index" class="btn btn-outline-secondary">
                 <i class="bi bi-arrow-left"></i> Back to List
             </a>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="needs-validation">
        <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

        <input asp-for="Role_Id" type="hidden" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pb-0 pt-4">
                <h5 class="fw-bold"><i class="bi bi-shield-check text-primary me-2"></i> Role Definition</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label asp-for="Role_Name" class="form-label text-muted fw-bold small text-uppercase">Unique Role Name</label>
                        <input asp-for="Role_Name" class="form-control form-control-lg bg-light border-0" placeholder="e.g. Administrator" />
                        <span asp-validation-for="Role_Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 border mt-4">
                    <div>
                        <h6 class="fw-bold mb-1">Role Availability Status</h6>
                        <p class="text-muted small mb-0">Disabling this hides the role from future user assignments.</p>
                    </div>
                    <div>
                        <select asp-for="IsActive" class="form-select form-select-lg fw-bold p-2 px-4 shadow-sm @(Model.IsActive ? "border-success text-success bg-success bg-opacity-10" : "border-danger text-danger bg-danger bg-opacity-10")" style="appearance: none; cursor: pointer;">
                            <option value="true">🟢 Active Status</option>
                            <option value="false">🔴 Inactive Status</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">
                <i class="bi bi-save2"></i> Update Role Definition
            </button>
        </div>
    </form>
</div>
