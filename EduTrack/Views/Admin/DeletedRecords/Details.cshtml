@model EduTrack.ViewModels.DeletedRecordViewModel
@{
    ViewData["Title"] = "Deleted Record Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-gradient bg-primary text-white">
            <h5 class="mb-0">Deleted Record Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Module</dt>
                <dd class="col-sm-9">@Model.Module</dd>

                <dt class="col-sm-3">Record Id</dt>
                <dd class="col-sm-9">@Model.RecordId</dd>

                <dt class="col-sm-3">Display</dt>
                <dd class="col-sm-9">@Model.DisplayText</dd>

                <dt class="col-sm-3">Details</dt>
                <dd class="col-sm-9">@Model.Details</dd>

                <dt class="col-sm-3">Deleted By</dt>
                <dd class="col-sm-9">@Model.DeletedBy</dd>

                <dt class="col-sm-3">Deleted Date</dt>
                <dd class="col-sm-9">@(Model.DeletedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                <form method="post" asp-action="Restore" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="module" value="@Model.Module" />
                    <input type="hidden" name="id" value="@Model.RecordId" />
                    <button type="submit" class="btn btn-success">Restore</button>
                </form>
                <form method="post" asp-action="PermanentDelete" class="d-inline ms-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="module" value="@Model.Module" />
                    <input type="hidden" name="id" value="@Model.RecordId" />
                    <button type="submit" class="btn btn-danger">Permanent Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>