@model EduTrack.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Delete User";
    var roleName = ViewBag.RoleName as string ?? "None";
}

<div class="container mt-5">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-0 text-danger fw-bold">Delete User Profile</h2>
            <p class="text-muted">Review the user details before confirming permanent deletion.</p>
        </div>
        <div class="col-auto">
             <a asp-action="Index" class="btn btn-outline-secondary">
                 <i class="bi bi-arrow-left"></i> Back to List
             </a>
        </div>
    </div>

    <div class="card shadow-sm border-danger mb-4 border-2">
        <div class="card-header bg-danger bg-opacity-10 border-danger border-opacity-25 pb-0 pt-4">
            <h5 class="fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Danger Zone</h5>
        </div>
        <div class="card-body p-4">
            <h5 class="text-danger fw-bold mb-4">Are you sure you want to delete this user account? This action is permanent.</h5>
            
            <div class="row g-4 mb-2">
                <div class="col-md-6 border-start border-3 border-danger ps-4">
                    <span class="text-muted text-uppercase small fw-bold">User Name</span>
                    <p class="fs-4 fw-bold">@Model.User_Name</p>
                </div>

                <div class="col-md-6 border-start border-3 border-danger ps-4">
                    <span class="text-muted text-uppercase small fw-bold">Email Address</span>
                    <p class="fs-4 fw-bold">@Model.Email</p>
                </div>
            </div>

            <div class="row g-4 mt-1 mb-4">
                <div class="col-md-6 border-start border-3 border-danger ps-4">
                    <span class="text-muted text-uppercase small fw-bold">Assigned Role</span>
                    <p class="fs-4 fw-bold"><span class="badge bg-secondary">@roleName</span></p>
                </div>
                
                <div class="col-md-6 border-start border-3 border-danger ps-4">
                    <span class="text-muted text-uppercase small fw-bold">Current Status</span>
                    <p class="fs-4 fw-bold">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Inactive</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="User_Id" />

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm">
                <i class="bi bi-trash"></i> Confirm Deletion
            </button>
        </div>
    </form>
</div>