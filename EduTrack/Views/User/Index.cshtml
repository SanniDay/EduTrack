@model IEnumerable<EduTrack.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">User Management</h4>
        </div>

        <div class="card-body table-responsive">
            <table id="userTable" class="table table-bordered table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Role Name</th>
                        <th>Active</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int counter = 0; }
                    @if (Model != null)
                    {
                        @foreach (var user in Model)
                        {
                            counter++;
                            <tr>
                                <td>@counter</td>
                                <td>@user.User_Name</td>
                                <td>@user.Email</td>
                                <td>@user.Role_Name</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>@user.Created_Date.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Edit" asp-route-id="@user.User_Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.User_Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#userTable').DataTable({
                "pageLength": 10,
                "responsive": true
            });
        });
    </script>
}