@model IEnumerable<EduTrack.ViewModels.TeacherViewModel>

@{
    ViewData["Title"] = "Teacher List";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Teacher Management</h4>
            </div>

        </div>

        <div class="card-body table-responsive">
            <table id="teacherTable" class="table table-bordered table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Teacher Name</th>
                        <th>Phone Number</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int counter = 0;
                    }
                    @if (Model != null)
                    {
                        @foreach (var teacher in Model)
                        {
                            counter++;
                            <tr>
                                <td>@counter</td>
                                <td>@teacher.FullName</td>
                                <td>@teacher.Phone_No</td>
                                <td>
                                    @if (teacher.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @teacher.Created_Date.ToString("dd-MM-yyyy")
                                </td>
                                <td>
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="Edit"
                                           asp-route-id="@teacher.Teacher_Id"
                                           class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@teacher.Teacher_Id"
                                               class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#teacherTable').DataTable({
                pageLength: 10,
                responsive: true,
                stateSave: true,
                stateDuration: -1
            });
        });
    </script>
}