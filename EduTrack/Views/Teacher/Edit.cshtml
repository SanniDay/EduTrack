@model EduTrack.ViewModels.TeacherViewModel
@{
    ViewData["Title"] = "Edit Teacher Portfolio";
}

<div class="container mt-5">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-0 text-primary fw-bold">Edit Teacher Profile</h2>
            <p class="text-muted">Update contact information and system access levels here.</p>
        </div>
        <div class="col-auto">
             <a asp-action="Index" class="btn btn-outline-secondary">
                 <i class="bi bi-arrow-left"></i> Back to List
             </a>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="needs-validation">
        <div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

        <input asp-for="User_Id" type="hidden" />
        <input asp-for="Teacher_Id" type="hidden" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pb-0 pt-4">
                <h5 class="fw-bold"><i class="bi bi-person-lines-fill text-primary me-2"></i> Personal Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label text-muted fw-bold small text-uppercase">Full Name</label>
                        <input asp-for="FullName" class="form-control form-control-lg bg-light border-0" placeholder="e.g. John Doe" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone_No" class="form-label text-muted fw-bold small text-uppercase">Phone Number</label>
                        <input asp-for="Phone_No" class="form-control form-control-lg bg-light border-0" placeholder="(555) 555-5555" />
                        <span asp-validation-for="Phone_No" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pb-0 pt-4">
                 <h5 class="fw-bold"><i class="bi bi-shield-lock-fill text-danger me-2"></i> System Access</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 border">
                    <div>
                        <h6 class="fw-bold mb-1">Account Activation Status</h6>
                        <p class="text-muted small mb-0">Disabling this will deactivate the teacher's login credentials in the Users table.</p>
                    </div>
                    <div>
                        <select asp-for="IsActive" class="form-select form-select-lg fw-bold p-2 px-4 shadow-sm @(Model.IsActive ? "border-success text-success bg-success bg-opacity-10" : "border-danger text-danger bg-danger bg-opacity-10")" style="appearance: none; cursor: pointer;">
                            <option value="true">Active Status</option>
                            <option value="false">Inactive Status</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">
                <i class="bi bi-save2"></i> Update Teacher Portfolio
            </button>
        </div>
    </form>
</div>
