@page
@model EduTrack.Pages.Subjects.EditModel
@{
    ViewData["Title"] = "Edit Subject";
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit Subject
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form method="post" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationAlert" role="alert"></div>

                        <input type="hidden" asp-for="Subject.Subject_Id" />
                        <input type="hidden" asp-for="Subject.Created_By" />
                        <input type="hidden" asp-for="Subject.Created_Date" />

                        <div class="mb-3">
                            <label asp-for="Subject.Subject_Code" class="form-label fw-bold">Subject Code <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-code-square"></i></span>
                                <input asp-for="Subject.Subject_Code" class="form-control" required />
                            </div>
                            <span asp-validation-for="Subject.Subject_Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject.Subject_Name" class="form-label fw-bold">Subject Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-book"></i></span>
                                <input asp-for="Subject.Subject_Name" class="form-control" required />
                            </div>
                            <span asp-validation-for="Subject.Subject_Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject.Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Subject.Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Subject.Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input type="checkbox" asp-for="Subject.IsActive" class="form-check-input" id="isActiveCheck" />
                                <label class="form-check-label" for="isActiveCheck"><strong>Active</strong></label>
                            </div>
                        </div>

                        <div class="mb-3 text-muted small">
                            <div><strong>Created:</strong> @Model.Subject.Created_Date.ToString("dd MMM yyyy HH:mm") by @Model.Subject.Created_By</div>
                            <div><strong>Last Modified:</strong> @Model.Subject.Modified_Date.ToString("dd MMM yyyy HH:mm")</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Update Subject
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary"> <i class="bi bi-arrow-left me-2"></i>Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        if (document.querySelectorAll('.text-danger').length > 0) {
            var el = document.getElementById('validationAlert');
            if (el) el.classList.remove('d-none');
        }
    </script>
}
