@page
@model EduTrack.Pages.Subjects.DeleteModel
@{
    ViewData["Title"] = "Delete Subject";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="alert alert-warning">
                <h4 class="alert-heading">⚠️ Confirm Deletion</h4>
                <p>Are you sure you want to delete this subject? This action cannot be undone.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-4"><strong>Subject Code:</strong></div>
                        <div class="col-8">@Model.Subject.Subject_Code</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Subject Name:</strong></div>
                        <div class="col-8">@Model.Subject.Subject_Name</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Description:</strong></div>
                        <div class="col-8">
                            @if (!string.IsNullOrEmpty(Model.Subject.Description))
                            {
                                <span>@Model.Subject.Description</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Status:</strong></div>
                        <div class="col-8">
                            @if (Model.Subject.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Created:</strong></div>
                        <div class="col-8">@Model.Subject.Created_Date.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden" name="id" value="@Model.Subject.Subject_Id" />
                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                    <div class="col-6">
                        <a asp-page="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
