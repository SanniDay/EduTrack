@page
@model EduTrack.Pages.Attendance.IndexModel

@{
    ViewData["Title"] = "Attendance Management";
}

<div class="container-fluid mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="bi bi-calendar-check-fill me-2"></i>Attendance Management
                    </h4>
                    @if (!User.IsInRole("Student"))
                    {
                        <a asp-page="Create" class="btn btn-light btn-sm">
                            <i class="bi bi-plus-circle me-1"></i>Mark Attendance
                        </a>
                    }
                </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-success alert-dismissible fade show m-3 mb-0" role="alert">
                <i class="bi bi-check-circle me-2"></i>@Model.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card-body">
            @if (Model.Attendance.Any())
            {
                <div class="table-responsive">
                    <table id="attendanceTable" class="table table-bordered table-hover align-middle w-100">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 5%">
                                    <i class="bi bi-hash"></i>
                                </th>
                                <th style="width: 15%">
                                    <i class="bi bi-person me-2"></i>Student
                                </th>
                                <th style="width: 12%">
                                    <i class="bi bi-door-open me-2"></i>Class
                                </th>
                                <th style="width: 12%">
                                    <i class="bi bi-book me-2"></i>Subject
                                </th>
                                <th style="width: 12%">
                                    <i class="bi bi-calendar me-2"></i>Date
                                </th>
                                <th style="width: 10%">Status</th>
                                <th style="width: 12%">Marked By</th>
                                <th style="width: 15%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var att in Model.Attendance)
                            {
                                <tr>
                                    <td class="fw-bold">@att.Attendance_Id</td>
                                    <td>
                                        <i class="bi bi-person-circle text-primary me-2"></i>@att.StudentName
                                    </td>
                                    <td>@att.ClassName</td>
                                    <td>@att.SubjectName</td>
                                    <td>
                                        <small class="text-muted">@att.Attendance_Date.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>
                                        @if (att.Status == "Present")
                                        {
                                            <span class="badge bg-success">Present</span>
                                        }
                                        else if (att.Status == "Absent")
                                        {
                                            <span class="badge bg-danger">Absent</span>
                                        }
                                        else if (att.Status == "Late")
                                        {
                                            <span class="badge bg-warning">Late</span>
                                        }
                                        else if (att.Status == "Leave")
                                        {
                                            <span class="badge bg-info">Leave</span>
                                        }
                                    </td>
                                    <td>@att.TeacherName</td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                                            @if (!User.IsInRole("Student"))
                                            {
                                                <a asp-page="Edit" asp-route-id="@att.Attendance_Id" 
                                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-page="Delete" asp-route-id="@att.Attendance_Id" 
                                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-page="Edit" asp-route-id="@att.Attendance_Id" 
                                                   class="btn btn-sm btn-outline-secondary" title="View" aria-disabled="true">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>No attendance records found. <a asp-page="Create">Mark attendance now</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#attendanceTable').DataTable({
                pageLength: 10,
                responsive: true,
                stateSave: true,
                order: [[4, 'desc']],
                language: {
                    search: "Search attendance:",
                    lengthMenu: "Show _MENU_ entries"
                }
            });
        });
    </script>
}
