@page "{id:int}"
@model EduTrack.Pages.Attendance.DeleteModel
@inject EduTrack.Interfaces.IStudentClassService StudentClassService
@inject EduTrack.Interfaces.IStudentService StudentService

@{
    ViewData["Title"] = "Delete Attendance";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">

            <div class="alert alert-warning">
                <h4 class="alert-heading">
                    ⚠️ Confirm Deletion
                </h4>

                <p>
                    Are you sure you want to delete this attendance record?
                    This action cannot be undone.
                </p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">

                    @{
                        var sc = StudentClassService.GetStudentClassById(Model.AttendanceItem.Student_Class_Id);
                        var student = sc != null ? StudentService.GetById(sc.Student_Id) : null;
                    }

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Student:</strong>
                        </div>

                        <div class="col-8">
                            @(student?.FullName ?? "N/A")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Date:</strong>
                        </div>

                        <div class="col-8">
                            @Model.AttendanceItem.Attendance_Date.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Status:</strong>
                        </div>

                        <div class="col-8">
                            @if (Model.AttendanceItem.Status == "Present")
                            {
                                <span class="badge bg-success">
                                    @Model.AttendanceItem.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    @Model.AttendanceItem.Status
                                </span>
                            }
                        </div>
                    </div>

                </div>
            </div>

            <form method="post" class="mt-4">

                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>

                    <div class="col-6">
                        <a asp-page="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>