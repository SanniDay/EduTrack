@page "{id:int}"
@model EduTrack.Pages.StudentClasses.EditModel

@{
    ViewData["Title"] = "Edit Student Class";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Student Class</h5>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationAlert"></div>
                        <input type="hidden" name="StudentClassViewModel.Student_Class_Id" value="@Model.StudentClassViewModel.Student_Class_Id">

                        <div class="mb-3">
                            <label for="Student_Id" class="form-label fw-bold">Student <span class="text-danger">*</span></label>
                            <select class="form-select" id="Student_Id" name="StudentClassViewModel.Student_Id" required>
                                <option value="">-- Select Student --</option>
                                @foreach (var student in Model.Students)
                                {
                                    <option value="@student.Student_Id" selected="@(student.Student_Id == Model.StudentClassViewModel.Student_Id)">@student.FullName</option>
                                }
                            </select>
                            <span class="text-danger small">@Html.ValidationMessageFor(m => m.StudentClassViewModel.Student_Id)</span>
                        </div>

                        <div class="mb-3">
                            <label for="Class_Id" class="form-label fw-bold">Class <span class="text-danger">*</span></label>
                            <select class="form-select" id="Class_Id" name="StudentClassViewModel.Class_Id" required>
                                <option value="">-- Select Class --</option>
                                @foreach (var cls in Model.Classes)
                                {
                                    <option value="@cls.Class_Id" selected="@(cls.Class_Id == Model.StudentClassViewModel.Class_Id)">@cls.ClassName - @cls.Section</option>
                                }
                            </select>
                            <span class="text-danger small">@Html.ValidationMessageFor(m => m.StudentClassViewModel.Class_Id)</span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="StudentClassViewModel.IsActive" value="true" checked="@Model.StudentClassViewModel.IsActive">
                                <label class="form-check-label" for="IsActive"><strong>Active</strong></label>
                            </div>
                        </div>

                        <div class="mb-3 text-muted small">
                            <div><strong>Created:</strong> @Model.StudentClassViewModel.Created_By - @Model.StudentClassViewModel.Created_Date.ToString("dd/MM/yyyy HH:mm")</div>
                            <div><strong>Modified:</strong> @Model.StudentClassViewModel.Modified_By - @Model.StudentClassViewModel.Modified_Date.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-circle me-2"></i>Update Assignment</button>
                            <a asp-page="Index" class="btn btn-outline-secondary"> <i class="bi bi-arrow-left me-2"></i>Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        if (document.querySelectorAll('.text-danger').length > 0) {
            var el = document.getElementById('validationAlert'); if (el) el.classList.remove('d-none');
        }
    </script>
}
