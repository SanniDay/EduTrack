@page "{id:int}"
@model EduTrack.Pages.ClassSubjects.DeleteModel
@inject EduTrack.Interfaces.IClassService ClassService
@inject EduTrack.Interfaces.ISubjectService SubjectService

@{
    ViewData["Title"] = "Delete Class Subject";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">

            <div class="alert alert-warning">
                <h4 class="alert-heading">
                    ⚠️ Confirm Deletion
                </h4>

                <p>
                    Are you sure you want to delete this class subject?
                    This action cannot be undone.
                </p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>ID:</strong>
                        </div>

                        <div class="col-8">
                            @Model.ClassSubject.ClassSubject_Id
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Class:</strong>
                        </div>

                        <div class="col-8">
                            @(ClassService.GetClassById(Model.ClassSubject.Class_Id)?.ClassName ?? "N/A")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Subject:</strong>
                        </div>

                        <div class="col-8">
                            @(SubjectService.GetById(Model.ClassSubject.Subject_Id)?.Subject_Name ?? "N/A")
                        </div>
                    </div>

                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden" name="id" value="@Model.ClassSubject.ClassSubject_Id" />

                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>

                    <div class="col-6">
                        <a asp-page="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>