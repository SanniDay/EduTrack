@page
@model EduTrack.Pages.TeacherClasses.CreateModel

@{
    ViewData["Title"] = "Assign Teacher to Class";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Assign Teacher to Class</h5>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationAlert"></div>

                        <div class="mb-3">
                            <label for="Teacher_Id" class="form-label fw-bold">Teacher <span class="text-danger">*</span></label>
                            <select class="form-select" id="Teacher_Id" name="TeacherClassViewModel.Teacher_Id" required>
                                <option value="">-- Select Teacher --</option>
                                @foreach (var teacher in Model.Teachers)
                                {
                                    <option value="@teacher.Teacher_Id">@teacher.FullName</option>
                                }
                            </select>
                            <span class="text-danger small">@Html.ValidationMessageFor(m => m.TeacherClassViewModel.Teacher_Id)</span>
                        </div>

                        <div class="mb-3">
                            <label for="ClassSubject_Id" class="form-label fw-bold">Class Subject <span class="text-danger">*</span></label>
                            <select class="form-select" id="ClassSubject_Id" name="TeacherClassViewModel.ClassSubject_Id" required>
                                <option value="">-- Select Class Subject --</option>
                                @foreach (var cs in Model.ClassSubjects)
                                {
                                    <option value="@cs.ClassSubject_Id">@cs.Class_Id - @cs.Subject_Id</option>
                                }
                            </select>
                            <span class="text-danger small">@Html.ValidationMessageFor(m => m.TeacherClassViewModel.ClassSubject_Id)</span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="TeacherClassViewModel.IsActive" value="true" checked>
                                <label class="form-check-label" for="IsActive"><strong>Active</strong></label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-check-circle me-2"></i>Assign Teacher</button>
                            <a asp-page="Index" class="btn btn-outline-secondary"> <i class="bi bi-arrow-left me-2"></i>Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        if (document.querySelectorAll('.text-danger').length > 0) { var el = document.getElementById('validationAlert'); if (el) el.classList.remove('d-none'); }
    </script>
}

