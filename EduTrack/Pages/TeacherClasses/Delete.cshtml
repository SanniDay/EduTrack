@page "{id:int}"
@model EduTrack.Pages.TeacherClasses.DeleteModel

@{
    ViewData["Title"] = "Delete Teacher Class";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">

            <div class="alert alert-warning">
                <h4 class="alert-heading">
                    ⚠️ Confirm Deletion
                </h4>

                <p>
                    Are you sure you want to delete this teacher class assignment?
                    This action cannot be undone.
                </p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Teacher:</strong>
                        </div>

                        <div class="col-8">
                            @Model.TeacherClassViewModel.TeacherName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Class:</strong>
                        </div>

                        <div class="col-8">
                            @Model.TeacherClassViewModel.ClassName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Subject:</strong>
                        </div>

                        <div class="col-8">
                            @Model.TeacherClassViewModel.SubjectName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Created By:</strong>
                        </div>

                        <div class="col-8">
                            @Model.TeacherClassViewModel.Created_By
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Created Date:</strong>
                        </div>

                        <div class="col-8">
                            @Model.TeacherClassViewModel.Created_Date.ToString("dd MMM yyyy HH:mm")
                        </div>
                    </div>

                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden"
                       name="id"
                       value="@Model.TeacherClassViewModel.Teacher_Class_Id" />

                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>

                    <div class="col-6">
                        <a href="/TeacherClasses/Index"
                           class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>