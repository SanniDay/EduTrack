@page
@model EduTrack.Pages.TimeTable.DetailsModel
@{
    ViewData["Title"] = "TimeTable Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white py-3 px-4 border-0">
                    <h4 class="mb-0 fw-semibold">
                        <i class="bi bi-calendar-week me-2"></i>
                        TimeTable Details
                    </h4>
                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">
                            <small class="text-muted d-block">Class</small>
                            <div class="fw-semibold">@Model.Item.ClassName</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Subject</small>
                            <div class="fw-semibold">@Model.Item.SubjectName</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Teacher</small>
                            <div class="fw-semibold">@Model.Item.TeacherName</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Day</small>
                            <div class="fw-semibold">@Model.Item.Day_Name</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Period</small>
                            <div class="fw-semibold">Period @Model.Item.Period_No</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Time</small>
                            <div class="fw-semibold">
                                @Model.Item.Start_Time.ToString() - @Model.Item.End_Time.ToString()
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Room</small>
                            <div class="fw-semibold">@Model.Item.Room_No</div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Status</small>

                            @if (Model.Item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
                                    Inactive
                                </span>
                            }
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Back to List
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>