@page
@model EduTrack.Pages.TimeTable.DeleteModel
@{
    ViewData["Title"] = "Delete TimeTable";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-danger bg-gradient text-white p-4 text-center">
                    <div class="mb-3">
                        <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center"
                             style="width: 70px; height: 70px;">
                            <i class="bi bi-trash3-fill fs-2"></i>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-1">Delete TimeTable Entry</h3>
                    <p class="mb-0 small opacity-75">
                        This action cannot be undone
                    </p>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex align-items-start">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>

                        <div>
                            <h6 class="fw-semibold mb-1">
                                Confirm Deletion
                            </h6>

                            <p class="mb-0 text-muted">
                                Are you sure you want to permanently remove this timetable entry?
                            </p>
                        </div>
                    </div>

                    <form method="post" class="mt-4">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">

                            <a asp-page="Index"
                               class="btn btn-light border px-4 rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4 rounded-pill shadow-sm">
                                <i class="bi bi-trash3-fill me-1"></i>
                                Delete
                            </button>

                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>