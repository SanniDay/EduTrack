@page
@model EduTrack.Pages.TimeTable.IndexModel
@{
    ViewData["Title"] = "Time Table";
}

<div class="container-fluid mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>Time Table</h5>
            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
            {
                <div>
                    <a asp-page="Create" class="btn btn-light btn-sm"><i class="bi bi-plus-circle me-1"></i>Create Session</a>
                </div>
            }
        </div>
        <div class="card-body">
            <form method="get" class="row g-2 mb-3">
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search by room" />
                </div>
                <div class="col-md-3">
                    <select name="classId" class="form-select">
                        <option value="">All Classes</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="day" class="form-select">
                        <option value="">All Days</option>
                        <option>Monday</option>
                        <option>Tuesday</option>
                        <option>Wednesday</option>
                        <option>Thursday</option>
                        <option>Friday</option>
                        <option>Saturday</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">Filter</button>
                </div>
            </form>

            @if (Model.Items.Any())
            {
                var groupedByClass = Model.Items.GroupBy(x => x.ClassName).OrderBy(g => g.Key);
                var daysOfWeek = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
                
                <div class="accordion" id="timetableAccordion">
                    @{ int accIndex = 0; }
                    @foreach (var classGroup in groupedByClass)
                    {
                        var collapseId = "collapseClass" + accIndex;
                        var headingId = "headingClass" + accIndex;
                        <div class="accordion-item shadow-sm border-0 mb-3 rounded-3 overflow-hidden">
                            <h2 class="accordion-header" id="@headingId">
                                <button class="accordion-button @(accIndex != 0 ? "collapsed" : "") bg-light text-dark fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(accIndex == 0 ? "true" : "false")" aria-controls="@collapseId">
                                    <i class="bi bi-door-open-fill me-2 text-primary fs-5"></i> <span class="fs-5">Class: @classGroup.Key</span>
                                    <span class="badge bg-primary ms-3 rounded-pill">@classGroup.Count() sessions</span>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse @(accIndex == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#timetableAccordion">
                                <div class="accordion-body bg-white p-4">
                                    <div class="row g-4">
                                        @foreach (var day in daysOfWeek)
                                        {
                                            var dayItems = classGroup.Where(x => (x.Day_Name ?? "").Equals(day, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.Period_No).ToList();
                                            if (dayItems.Any())
                                            {
                                                <div class="col-md-6 col-lg-4">
                                                    <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                                                        <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                                                            <h6 class="fw-bold text-uppercase text-primary mb-0"><i class="bi bi-calendar-day me-2"></i>@day</h6>
                                                        </div>
                                                        <div class="card-body p-3">
                                                            <div class="d-flex flex-column gap-3">
                                                                @foreach(var item in dayItems)
                                                                {
                                                                    <div class="p-3 bg-white rounded-3 shadow-sm border border-light position-relative hover-lift" style="transition: transform 0.2s;">
                                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                                            <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill">Period @item.Period_No</span>
                                                                            <span class="small fw-bold text-muted"><i class="bi bi-clock me-1"></i>@item.Start_Time.ToString("hh\\:mm") - @item.End_Time.ToString("hh\\:mm")</span>
                                                                        </div>
                                                                        
                                                                        <div class="fw-bold mb-1 fs-6">Room: @item.Room_No</div>
                                                                        
                                                                        <div class="d-flex justify-content-between align-items-end mt-3">
                                                                            <div>
                                                                                @if (item.IsActive)
                                                                                {
                                                                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-dash-circle-fill me-1"></i>Inactive</span>
                                                                                }
                                                                            </div>
                                                                            <div class="btn-group">
                                                                                <a asp-page="Details" asp-route-id="@item.TimeTable_Id" class="btn btn-sm btn-light text-primary border" title="View Details"><i class="bi bi-eye"></i></a>
                                                                                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                                                                                {
                                                                                    <a asp-page="Edit" asp-route-id="@item.TimeTable_Id" class="btn btn-sm btn-light text-warning border" title="Edit Session"><i class="bi bi-pencil-square"></i></a>
                                                                                    <a asp-page="Delete" asp-route-id="@item.TimeTable_Id" class="btn btn-sm btn-light text-danger border" title="Delete Session"><i class="bi bi-trash"></i></a>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        accIndex++;
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">No timetable entries found.</div>
            }
        </div>
    </div>
</div>
