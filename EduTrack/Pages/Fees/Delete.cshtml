@page "{id:int}"
@model EduTrack.Pages.Fees.DeleteModel
@{
    ViewData["Title"] = "Delete Fee";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="alert alert-warning">
                <h4 class="alert-heading">⚠️ Confirm Deletion</h4>
                <p>Are you sure you want to delete this fee record? This action cannot be undone.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-4"><strong>Fee Type:</strong></div>
                        <div class="col-8">@Model.Fee.FeeType</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Amount:</strong></div>
                        <div class="col-8">@Model.Fee.Amount.ToString("C")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Description:</strong></div>
                        <div class="col-8">
                            @if (!string.IsNullOrEmpty(Model.Fee.Description))
                            {
                                <span>@Model.Fee.Description</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4"><strong>Created:</strong></div>
                        <div class="col-8">@Model.Fee.Created_Date.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden" name="id" value="@Model.Fee.Fees_Id" />
                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                    <div class="col-6">
                        <a asp-page="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
