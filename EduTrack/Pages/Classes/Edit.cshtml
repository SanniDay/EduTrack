@page
@model EduTrack.Pages.Classes.EditModel
@{
    ViewData["Title"] = "Edit Class";
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit Class
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form method="post" class="needs-validation">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger d-none"
                             id="validationAlert"
                             role="alert">
                        </div>

                        <input type="hidden" asp-for="Class.Class_Id" />
                        <input type="hidden" asp-for="Class.Created_By" />
                        <input type="hidden" asp-for="Class.Created_Date" />

                        <div class="mb-3">
                            <label asp-for="Class.ClassName" class="form-label fw-bold">
                                Class Name <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-mortarboard"></i>
                                </span>

                                <input asp-for="Class.ClassName"
                                       class="form-control"
                                       placeholder="Enter Class Name"
                                       required />
                            </div>

                            <span asp-validation-for="Class.ClassName"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Class.Section" class="form-label fw-bold">
                                Section <span class="text-danger">*</span>
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-diagram-3"></i>
                                </span>

                                <input asp-for="Class.Section"
                                       class="form-control"
                                       placeholder="Enter Section"
                                       required />
                            </div>

                            <span asp-validation-for="Class.Section"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input type="checkbox"
                                       asp-for="Class.IsActive"
                                       class="form-check-input"
                                       id="isActiveCheck" />

                                <label class="form-check-label"
                                       for="isActiveCheck">
                                    <strong>Active</strong>
                                </label>
                            </div>
                        </div>

                        <div class="mb-3 text-muted small">
                            <div>
                                <strong>Created:</strong>
                                @Model.Class.Created_Date.ToString("dd MMM yyyy HH:mm")
                                by @Model.Class.Created_By
                            </div>

                            <div>
                                <strong>Last Modified:</strong>
                                @Model.Class.Modified_Date.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Update Class
                            </button>

                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back to List
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        if (document.querySelectorAll('.text-danger').length > 0) {
            var el = document.getElementById('validationAlert');
            if (el) el.classList.remove('d-none');
        }
    </script>
}