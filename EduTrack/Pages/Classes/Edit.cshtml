@page
@model EduTrack.Pages.Classes.EditModel
@{
    ViewData["Title"] = "Edit Class";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2>Edit Class</h2>
            <hr />

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <input type="hidden" asp-for="Class.Class_Id" />
                <input type="hidden" asp-for="Class.Created_By" />
                <input type="hidden" asp-for="Class.Created_Date" />

                <div class="mb-3">
                    <label asp-for="Class.ClassName" class="form-label"></label>
                    <input asp-for="Class.ClassName" class="form-control" />
                    <span asp-validation-for="Class.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Class.Section" class="form-label"></label>
                    <input asp-for="Class.Section" class="form-control" />
                    <span asp-validation-for="Class.Section" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" asp-for="Class.IsActive" class="form-check-input" />
                    <label asp-for="Class.IsActive" class="form-check-label"></label>
                </div>

                <div class="mb-3 text-muted">
                    <small>
                        <strong>Created:</strong> @Model.Class.Created_Date.ToString("dd MMM yyyy HH:mm") by @Model.Class.Created_By<br />
                        <strong>Last Modified:</strong> @Model.Class.Modified_Date.ToString("dd MMM yyyy HH:mm")
                    </small>
                </div>

                <div class="row">
                    <div class="col-6">
                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-check-circle"></i> Update
                        </button>
                    </div>
                    <div class="col-6">
                        <a asp-page="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
