@page
@model EduTrack.Pages.Classes.IndexModel

@{
    ViewData["Title"] = "Classes Management";
}

<div class="container-fluid mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient bg-info text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-door-open me-2"></i>Classes Management
                </h4>
                <a asp-page="Create" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Add Class
                </a>
            </div>
        </div>



        <div class="card-body">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive">
                    <table id="classesTable" class="table table-bordered table-hover align-middle w-100">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 5%">
                                    <i class="bi bi-hash"></i>
                                </th>
                                <th style="width: 25%">
                                    <i class="bi bi-door-open me-2"></i>Class Name
                                </th>
                                <th style="width: 12%">Section</th>
                                <th style="width: 15%">Created By</th>
                                <th style="width: 13%">Created Date</th>
                                <th style="width: 10%">Status</th>
                                <th style="width: 20%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cls in Model.Classes)
                            {
                                <tr>
                                    <td class="fw-bold">@cls.Class_Id</td>
                                    <td>
                                        <i class="bi bi-door-open text-info me-2"></i><strong>@cls.ClassName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@cls.Section</span>
                                    </td>
                                    <td>@cls.Created_By</td>
                                    <td>
                                        <small class="text-muted">@cls.Created_Date.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td>
                                        @if (cls.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning">
                                                <i class="bi bi-dash-circle me-1"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                                            <a asp-page="Edit" asp-route-id="@cls.Class_Id" 
                                               class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@cls.Class_Id" 
                                               class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="text-muted mt-3">No Classes Found</h5>
                    <p class="text-secondary">Get started by <a asp-page="Create" class="text-decoration-none">creating a new class</a></p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#classesTable').DataTable({
                "pageLength": 10,
                "responsive": true,
                "stateSave": true,
                "language": {
                    "search": "Search classes:",
                    "lengthMenu": "Show _MENU_ entries"
                }
            });
        });
    </script>
}
