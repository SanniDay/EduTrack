@page
@model EduTrack.Pages.StudentFees.CreateModel
@{
    ViewData["Title"] = "Create Student Fee";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Create Student Fee</h5>
                </div>

                <div class="card-body p-4">
                    <form method="post" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationAlert"></div>

                        <div class="mb-3">
                            <label asp-for="Item.Student_Id" class="form-label fw-bold">Student <span class="text-danger">*</span></label>
                            <select asp-for="Item.Student_Id" asp-items="Model.Students" class="form-select" required>
                                <option value="">-- Select Student --</option>
                            </select>
                            <span asp-validation-for="Item.Student_Id" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.Fees_Id" class="form-label fw-bold">Fee Type <span class="text-danger">*</span></label>
                            <select asp-for="Item.Fees_Id" asp-items="Model.Fees" class="form-select" required>
                                <option value="">-- Select Fee --</option>
                            </select>
                            <span asp-validation-for="Item.Fees_Id" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.Amount" class="form-label fw-bold">Amount</label>
                            <input asp-for="Item.Amount" class="form-control" type="number" step="0.01" required />
                            <span asp-validation-for="Item.Amount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.Status" class="form-label fw-bold">Status</label>
                            <select asp-for="Item.Status" class="form-select">
                                <option value="1">Pending</option>
                                <option value="2">Paid</option>
                                <option value="3">Overdue</option>
                                <option value="4">Exempted</option>
                                <option value="5">PartiallyPaid</option>
                            </select>
                            <span asp-validation-for="Item.Status" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.DueDate" class="form-label fw-bold">Due Date</label>
                            <input asp-for="Item.DueDate" class="form-control" type="date" />
                            <span asp-validation-for="Item.DueDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.PaidDate" class="form-label fw-bold">Paid Date</label>
                            <input asp-for="Item.PaidDate" class="form-control" type="date" />
                            <span asp-validation-for="Item.PaidDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.PaymentMethod" class="form-label fw-bold">Payment Method</label>
                            <input asp-for="Item.PaymentMethod" class="form-control" />
                            <span asp-validation-for="Item.PaymentMethod" class="text-danger small"></span>
                        </div>



                        <div class="mb-3">
                            <label asp-for="Item.Notes" class="form-label fw-bold">Notes</label>
                            <textarea asp-for="Item.Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Item.Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg"><i class="bi bi-check-circle me-2"></i>Create Fee Record</button>
                            <a asp-page="Index" class="btn btn-outline-secondary"> <i class="bi bi-arrow-left me-2"></i>Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        if (document.querySelectorAll('.text-danger').length > 0) { var el = document.getElementById('validationAlert'); if (el) el.classList.remove('d-none'); }
    </script>
}
